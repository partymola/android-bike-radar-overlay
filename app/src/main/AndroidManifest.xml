<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- WAKE_LOCK: held ONLY during a live-ride off-episode (the radar dropped
         while the rider is still moving), bounded by a hard timeout cap and
         released the moment the episode resolves. See the wakelock-posture
         rationale on the service below, RideWakeLock, and the Privacy screen. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Approximate location is used solely to compute sunrise/sunset for the
         front- and radar-light day/night auto-modes. Read once per ride session via
         getLastKnownLocation (no continuous tracking, no background
         polling). City-block accuracy is sufficient: a 10 km position
         error shifts computed sunrise by ~1 minute. If the permission is
         denied, auto-mode falls back to London-hardcoded times. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE"
        tools:targetApi="34" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:targetApi="34" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Android 11+ package visibility: without this, getLaunchIntentForPackage
         for Bosch Flow returns null even when it is installed, so the
         "Open Flow to pair" action falls back to the Play Store instead of
         opening the app. -->
    <queries>
        <package android:name="com.bosch.ebike.onebikeapp" />
    </queries>

    <!-- Backups are ON so settings and the Home Assistant credentials move
         to a new phone (cloud backup, lockscreen-secret-encrypted, plus the
         direct device-to-device transfer). Ride history, capture logs, crash
         reports and the link journal live in app-specific EXTERNAL storage,
         which @xml/data_extraction_rules explicitly EXCLUDES from both -
         Auto Backup would include it by default. -->
    <application
        android:name=".BikeRadarApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BikeRadar"
        android:usesCleartextTraffic="true">
        <!-- HA URL: cleartext HTTP is allowed at OS level so LAN setups
             keep working. A network-security-config is deliberately NOT
             used: NSC matches cleartext exemptions by hostname/domain,
             but the policy we need is "cleartext only to RFC1918 /
             loopback / ULA / link-local addresses" and the HA host is an
             arbitrary user-configured LAN IP that no domain-config can
             enumerate. Enforcement is therefore app-level: HaUrlPolicy
             requires HTTPS for any non-LAN host, so the bearer token
             never leaves over HTTP to the WAN. -->


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BikeRadar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wakelock posture: the FGS's implicit wakelock is sufficient while
             the device is awake or dozing-light. In deep Doze, `delay()` ticks
             driving the V2 watchdog and walk-away timer are deferred until the
             next maintenance window - fine for a parked phone, but a rider whose
             radar drops MID-RIDE with no other BLE accessory (no dashcam probe
             loop, no eBike) then gets the dead-radar cue and walk-away alarm
             minutes late. So a bounded PARTIAL_WAKE_LOCK (RideWakeLock) is held
             ONLY during a live-ride off-episode: acquired when the radar drops
             while the rider was recently moving, released on reconnect / walk-
             away BLANK / ride summary, and hard-capped so it can never persist.
             The old blanket "no wakelock" concern was the parked-phone idle
             case, which the recent-activity acquire gate deliberately excludes. -->
        <service
            android:name=".BikeRadarService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BatteryScanReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="es.jjrh.bikeradar.BATTERY_SCAN_RESULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Dev-only replay, synthetic-scenario and radar-light actions.
             Not exported: a peer app must never be able to start the debug
             overlay/replay FGSes, even on a device where the user has
             flipped devModeUnlocked. Keep it that way. Reach all three from
             the Debug screen; driving them by shell broadcast is not a
             supported route and has never been seen to work. -->
        <receiver
            android:name=".RemoteControlReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="es.jjrh.bikeradar.DEV_REPLAY" />
                <action android:name="es.jjrh.bikeradar.DEV_SYNTH" />
                <action android:name="es.jjrh.bikeradar.DEV_RADAR_LIGHT_WRITE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".InternalControlReceiver"
            android:exported="false" />

        <service
            android:name=".DebugOverlayService"
            android:exported="false"
            android:foregroundServiceType="shortService"
            tools:targetApi="34" />

        <service
            android:name=".ReplayService"
            android:exported="false"
            android:foregroundServiceType="shortService"
            tools:targetApi="34" />

        <service
            android:name=".SyntheticScenarioService"
            android:exported="false"
            android:foregroundServiceType="shortService"
            tools:targetApi="34" />

        <service
            android:name=".ScreenshotCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            tools:targetApi="34" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
